@echo off
setlocal EnableExtensions EnableDelayedExpansion
chcp 65001 >nul
title CrowX Ultra Security Workspace - WatchCrow + HoneySpot
set "CROWX_BAT=%~f0"
set "CROWX_INSTALL=%LOCALAPPDATA%\CrowX"
set "CROWX_BACKEND=%LOCALAPPDATA%\CrowX\backend"
set "PY="
set "OPENSSL_EXE="
rem Prefer a real CPython installation over the Microsoft Store alias.
for %%P in ("%LOCALAPPDATA%\Programs\Python\Python312\python.exe" "%LOCALAPPDATA%\Programs\Python\Python313\python.exe" "%ProgramFiles%\Python312\python.exe" "%ProgramFiles%\Python313\python.exe") do if not defined PY if exist "%%~P" set "PY=%%~P"
if not defined PY for /f "delims=" %%P in ('where python.exe 2^>nul') do if not defined PY if exist "%%P" set "PY=%%P"
if not defined PY if exist "%LocalAppData%\Microsoft\WindowsApps\py.exe" for /f "delims=" %%P in ('py -3.12 -c "import sys; print(sys.executable)" 2^>nul') do if exist "%%P" set "PY=%%P"
if not defined PY (
 echo [1/7] Python 3.12 with Tkinter was not found. Installing it for the current user...
 where winget.exe >nul 2>&1
 if errorlevel 1 (echo WinGet is unavailable. Install App Installer from Microsoft Store, then rerun.&pause&exit /b 1)
 winget install --id Python.Python.3.12 -e --scope user --override "InstallAllUsers=0 PrependPath=1 Include_test=0" --accept-package-agreements --accept-source-agreements
 if errorlevel 1 (echo Python installation failed. No changes were made to CrowX.&pause&exit /b 1)
 timeout /t 2 /nobreak >nul
 for %%P in ("%LOCALAPPDATA%\Programs\Python\Python312\python.exe" "%LOCALAPPDATA%\Programs\Python\Python313\python.exe") do if not defined PY if exist "%%~P" set "PY=%%~P"
 if not defined PY for /f "delims=" %%P in ('where python.exe 2^>nul') do if not defined PY if exist "%%P" set "PY=%%P"
 if not defined PY if exist "%LocalAppData%\Microsoft\WindowsApps\py.exe" for /f "delims=" %%P in ('py -3.12 -c "import sys; print(sys.executable)" 2^>nul') do if exist "%%P" set "PY=%%P"
)
if not defined PY (echo Python was installed but could not be located. Restart Windows or add Python to PATH, then rerun.&pause&exit /b 1)
echo Python selected: %PY%
if not exist "%CROWX_INSTALL%" mkdir "%CROWX_INSTALL%"
if not exist "%CROWX_BACKEND%" mkdir "%CROWX_BACKEND%"
echo [2/7] Extracting Python and transparent PNG...
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$raw=[IO.File]::ReadAllText($env:CROWX_BAT); $a=$raw.LastIndexOf('__CROWX_PY_BEGIN__')+'__CROWX_PY_BEGIN__'.Length; $b=$raw.IndexOf('__CROWX_PY_END__',$a); $py=$raw.Substring($a,$b-$a) -replace '\s',''; $c=$raw.LastIndexOf('__CROWX_PNG_BEGIN__')+'__CROWX_PNG_BEGIN__'.Length; $d=$raw.IndexOf('__CROWX_PNG_END__',$c); $png=$raw.Substring($c,$d-$c) -replace '\s',''; [IO.File]::WriteAllBytes((Join-Path $env:CROWX_INSTALL 'crowx.py'),[Convert]::FromBase64String($py)); [IO.File]::WriteAllBytes((Join-Path $env:CROWX_INSTALL 'crowx.png'),[Convert]::FromBase64String($png))"
if errorlevel 1 (echo Extraction failed.&pause&exit /b 1)
echo [3/7] Checking Tkinter...
"%PY%" -c "import tkinter" >nul 2>&1
if errorlevel 1 (echo Tkinter is missing. Reinstall Python with Tcl/Tk.&pause&exit /b 1)
echo [4/7] Installing OpenSSL...
for /f "delims=" %%P in ('where openssl.exe 2^>nul') do if not defined OPENSSL_EXE set "OPENSSL_EXE=%%P"
if not defined OPENSSL_EXE if exist "%ProgramFiles%\OpenSSL-Win64\bin\openssl.exe" set "OPENSSL_EXE=%ProgramFiles%\OpenSSL-Win64\bin\openssl.exe"
if not defined OPENSSL_EXE if exist "%ProgramFiles%\OpenSSL-Win32\bin\openssl.exe" set "OPENSSL_EXE=%ProgramFiles%\OpenSSL-Win32\bin\openssl.exe"
if not defined OPENSSL_EXE (
 for %%I in (ShiningLight.OpenSSL ShiningLight.OpenSSL.Light ShiningLight.OpenSSL.Dev) do (
  if not defined OPENSSL_EXE winget install --id %%I -e --accept-package-agreements --accept-source-agreements
  for /f "delims=" %%P in ('where openssl.exe 2^>nul') do if not defined OPENSSL_EXE set "OPENSSL_EXE=%%P"
  if not defined OPENSSL_EXE if exist "%ProgramFiles%\OpenSSL-Win64\bin\openssl.exe" set "OPENSSL_EXE=%ProgramFiles%\OpenSSL-Win64\bin\openssl.exe"
 )
)
if defined OPENSSL_EXE (
 for %%D in ("%ProgramFiles%\OpenSSL-Win64\bin" "%ProgramFiles%\OpenSSL-Win32\bin") do if exist "%%~D\openssl.exe" set "PATH=%%~D;!PATH!"
 echo OpenSSL ready: %OPENSSL_EXE%
) else echo OpenSSL was not detected. Run this BAT again after Winget finishes.
echo [5/7] Installing local Nuclei engine...
if not exist "%CROWX_INSTALL%\bin" mkdir "%CROWX_INSTALL%\bin"
if not exist "%CROWX_INSTALL%\bin\nuclei.exe" (
 powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $release=Invoke-RestMethod 'https://api.github.com/repos/projectdiscovery/nuclei/releases/latest'; $asset=$release.assets | Where-Object { $_.name -match 'windows_amd64.zip$' } | Select-Object -First 1; if (-not $asset) { throw 'Nuclei Windows asset not found' }; $zip=Join-Path $env:TEMP 'crowx-nuclei.zip'; Invoke-WebRequest $asset.browser_download_url -OutFile $zip; $dir=Join-Path $env:TEMP 'crowx-nuclei'; if (Test-Path $dir) { Remove-Item $dir -Recurse -Force }; Expand-Archive $zip $dir -Force; $exe=Get-ChildItem $dir -Filter nuclei.exe -Recurse | Select-Object -First 1; if (-not $exe) { throw 'nuclei.exe missing from archive' }; Copy-Item $exe.FullName (Join-Path $env:CROWX_INSTALL 'bin\nuclei.exe') -Force; Remove-Item $zip,$dir -Recurse -Force -ErrorAction SilentlyContinue"
 if errorlevel 1 echo Nuclei download failed. CrowX will continue without the local engine.
)
if exist "%CROWX_INSTALL%\bin\nuclei.exe" (
 "%CROWX_INSTALL%\bin\nuclei.exe" -update-templates -silent
 if errorlevel 1 echo Nuclei templates could not be updated; existing templates will be used.
 echo Nuclei engine ready: %CROWX_INSTALL%\bin\nuclei.exe
)
echo [6/7] Installing Local Editor runtimes (optional packages)...
where winget.exe >nul 2>&1
if not errorlevel 1 (
 for %%I in (Microsoft.PowerShell RubyInstallerTeam.RubyWithDevKit PHP.PHP GoLang.Go Rustlang.Rustup Oracle.JDK.21 Microsoft.DotNet.SDK.8 Google.DartSDK RProject.R ProjectDiscovery.Nuclei) do winget install --id %%I -e --scope user --accept-package-agreements --accept-source-agreements >nul 2>&1
 echo Core editor runtimes checked. Missing packages will be reported inside Local Editor.
) else echo WinGet unavailable; Local Editor will use runtimes already installed.
"%PY%" -m pip install --user --disable-pip-version-check pyyaml >nul 2>&1
"%PY%" -m pip install --user --disable-pip-version-check markdown >nul 2>&1
"%PY%" -m pip install --user --disable-pip-version-check cryptography >nul 2>&1
echo [5/7] Checking Docker Desktop...
where docker.exe >nul 2>&1
if errorlevel 1 winget install --id Docker.DockerDesktop -e --accept-package-agreements --accept-source-agreements
where docker.exe >nul 2>&1
if errorlevel 1 goto launch
docker info >nul 2>&1
if errorlevel 1 goto launch
echo [6/7] Starting backend containers...
if not exist "%CROWX_BACKEND%\compose.yaml" powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "Invoke-WebRequest -UseBasicParsing 'https://greenbone.github.io/docs/latest/_static/compose.yaml' -OutFile '%CROWX_BACKEND%\compose.yaml'"
if exist "%CROWX_BACKEND%\compose.yaml" docker compose -f "%CROWX_BACKEND%\compose.yaml" pull
if errorlevel 1 (echo Docker image download failed. Backend was not started.&pause&goto launch)
if exist "%CROWX_BACKEND%\compose.yaml" docker compose -f "%CROWX_BACKEND%\compose.yaml" up -d
if errorlevel 1 (echo Docker backend startup failed. CrowX will launch without the assessment backend.&pause&goto launch)
:launch
echo [7/7] Launching CrowX...
start "CrowX" "%PY%" "%CROWX_INSTALL%\crowx.py"
exit /b 0
__CROWX_PY_BEGIN__

__CROWX_PY_END__
__CROWX_PNG_BEGIN__

__CROWX_PNG_END__
